
:: BargainWithThief
<<set $textChunks to [
  "\"Please,\" the sethani begins, \"take all my jewelry, just let me pass and say nothing—\"",
  "But the thief laughs cruelly. \"You think jewels will buy my silence about such scandal? No, we want more than that.\"",
  "His cronies close in. The sethani realizes her mistake too late."
]>>
<<set $currentChunk to 0>>

<div id="scene">
  <div id="game-container">
    <img id="background" src="images/tunnel.jpg">
  </div>
  <div id="dialogue-box" onclick="nextChunk()">
    <div class="narration-text" id="text-display">$textChunks[$currentChunk]</div>
    <span id="next-link" style="display:none;">
      <p class="bad-end-text">
        <strong>Deception breeds more deception.</strong>
      </p>
      [[Try again - what should she have done?|ThiefsAmbush]]
    </span>

    <<script>>
      shakeSound.play();
      $('#passages').addClass('shake');
      setTimeout(function(){ $('#passages').removeClass('shake'); }, 500);
    <</script>>
  </div>
</div>

